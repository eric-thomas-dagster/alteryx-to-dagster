<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2023.1">
  <Nodes>
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.TextInput.TextInput">
        <Position x="54" y="54"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <NumRows value="6"/>
          <Fields>
            <Field name="region" type="V_String" size="50"/>
            <Field name="product" type="V_String" size="50"/>
            <Field name="quantity" type="Int32"/>
            <Field name="unit_price" type="Double"/>
          </Fields>
          <Data>
            <r><c>North</c><c>Widget</c><c>10</c><c>5.50</c></r>
            <r><c>North</c><c>Gadget</c><c>3</c><c>12.00</c></r>
            <r><c>South</c><c>Widget</c><c>7</c><c>5.50</c></r>
            <r><c>South</c><c>Gadget</c><c>15</c><c>12.00</c></r>
            <r><c>East</c><c>Widget</c><c>20</c><c>5.50</c></r>
            <r><c>West</c><c>Gadget</c><c>1</c><c>12.00</c></r>
          </Data>
        </Configuration>
      </Properties>
      <Annotation DefaultAnnotationText="raw_sales"/>
    </Node>
    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="200" y="54"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField field="revenue" type="Double" size="0" expression="[quantity] * [unit_price]"/>
            <FormulaField field="bulk_tier" type="V_String" size="20" expression="IIF([quantity] &gt; 10, &quot;bulk&quot;, &quot;standard&quot;)"/>
            <FormulaField field="is_widget" type="Bool" size="0" expression="Contains([product], &quot;Widget&quot;)"/>
          </FormulaFields>
        </Configuration>
      </Properties>
      <Annotation DefaultAnnotationText="enriched_sales"/>
    </Node>
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Sample.Sample">
        <Position x="350" y="54"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Mode>FirstN</Mode>
          <N>5</N>
        </Configuration>
      </Properties>
      <Annotation DefaultAnnotationText="top_5_sales"/>
    </Node>
    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.RecordID.RecordID">
        <Position x="500" y="54"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <FieldName>row_num</FieldName>
          <StartValue>1</StartValue>
        </Configuration>
      </Properties>
      <Annotation DefaultAnnotationText="numbered_sales"/>
    </Node>
    <Node ToolID="5">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="650" y="54"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <File>/tmp/alteryx-test/v15_output.csv</File>
        </Configuration>
      </Properties>
      <Annotation DefaultAnnotationText="output_csv"/>
    </Node>
  </Nodes>
  <Connections>
    <Connection><Origin ToolID="1" Connection="Output"/><Destination ToolID="2" Connection="Input"/></Connection>
    <Connection><Origin ToolID="2" Connection="Output"/><Destination ToolID="3" Connection="Input"/></Connection>
    <Connection><Origin ToolID="3" Connection="Output"/><Destination ToolID="4" Connection="Input"/></Connection>
    <Connection><Origin ToolID="4" Connection="Output"/><Destination ToolID="5" Connection="Input"/></Connection>
